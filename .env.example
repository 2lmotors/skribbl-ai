# Port d'écoute du serveur (par défaut 3000)
PORT=3000

# Clé API Google Gemini (Optionnelle - permet à l'IA d'analyser les dessins avec Gemini 1.5 Flash)
# Vous pouvez aussi la saisir directement dans l'interface de l'application via le bouton Réglages
# Obtenez une clé gratuite sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
